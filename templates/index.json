          "type": "benefit",
          "settings": {
            "icon_text": "typing.optimize()",
            "title": "Fewer Keys, More Speed",
            "text": "<p>Thumb clusters and layers replace reaching for distant keys. Your fingers travel less, and every key is within one key of home row.</p>"
          }
        },
