<link rel="stylesheet" href="{{ 'section-why-split-keyboards.css' | asset_url }}" media="print" onload="this.media='all'">

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="why-split" class="why-split color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="why-split__header center">
      <h2 class="why-split__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="why-split__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="why-split__grid grid grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="why-split__card grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_text != blank -%}
            <div class="why-split__icon--text">
              {{ block.settings.icon_text }}
            </div>
          {%- endif -%}
          <h3 class="why-split__card-title h3">{{ block.settings.title }}</h3>
          <div class="why-split__card-text rte">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="why-split__cta center">
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Why Split Keyboards?",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Why Split Keyboards?",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Designed for developers who type 8+ hours a day",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop All Keyboards"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text (code-style)",
          "default": "// benefit",
          "info": "Displayed in monospace as a code-style label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Ergonomic Comfort",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Split keyboards let your hands rest at shoulder width, eliminating wrist strain from traditional keyboards.</p>",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Split Keyboards?",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_text": "ergonomics()",
            "title": "Ergonomic by Design",
            "text": "<p>Your hands rest at natural shoulder width. No more hunching over a single keyboard slab. Columnar stagger aligns keys to your finger lengths.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_text": "typing.optimize()",
            "title": "Fewer Keys, More Speed",
            "text": "<p>Thumb clusters and layers replace reaching for distant keys. Your fingers travel less, and every key is within one key of home row.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_text": "firmware.flash()",
            "title": "Fully Programmable",
            "text": "<p>QMK/ZMK firmware lets you remap every key. Macros, layers, tap-dance, combos — your keyboard, your rules. Open source, forever.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
